# PostgreSQL connection (Prisma)
# Database name: college_transport (create it first: CREATE DATABASE college_transport;)
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/college_transport"

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# HypeGPS — real GPS tracking (server-side only)
# Never expose HYPEGPS_API_HASH to the frontend/browser.
HYPEGPS_API_URL=https://platform.hypegps.com/api/get_devices
HYPEGPS_API_HASH=your_hypegps_api_hash_here
HYPEGPS_HITAM_GROUP=
HYPEGPS_CACHE_TTL_SECONDS=5
HYPEGPS_STALE_SECONDS=120
